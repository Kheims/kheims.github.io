---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate, type Post } from '../../posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, description, date, updated, tags, draft } = post.data;
---

<Base title={title} description={description}>
  <article>
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span> · updated {formatDate(updated)}</span>}
        {tags.length > 0 && <span class="tags">{tags.map((t) => <span class="pill">{t}</span>)}</span>}
        {draft && <span class="draft-badge"> · draft, not published</span>}
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
